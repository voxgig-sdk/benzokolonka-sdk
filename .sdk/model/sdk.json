e\":\"number\"},\"minPrice\":{\"description\":\"Minimum fuel price found\",\"format\":\"float\",\"type\":\"number\"},\"priceChangeTrend\":{\"description\":\"Overall price trend (increasing, decreasing, stable)\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successful response containing fuel station list with price statistics\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing the issue\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad Request - Invalid parameters provided\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing the server issue\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal Server Error\"}},\"securitySource\":\"unspecified\"}",
