# Entity: fuel_price

main: kit: entity: fuel_price: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: false
      short: "Physical address of the station"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the fuel station"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "lastUpdated"
      req: false
      short: "Timestamp of last price update"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the fuel station"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "price"
      req: false
      short: "Current fuel price"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "priceChange"
      req: false
      short: "Price change over the specified period"
      type: "`$NUMBER`"
    }
    {
      name: "region"
      req: false
      short: "Region ID where the station is located"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "fuel_price"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "ai95"
                kind: "query"
                name: "fuel"
                orig: "fuel"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: 7
                kind: "query"
                name: "period"
                orig: "period"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 4
                kind: "query"
                name: "region"
                orig: "region"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/home"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "home"
            }
          ]
          select: {
            exist: [
              "fuel"
              "period"
              "region"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
